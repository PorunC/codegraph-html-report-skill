{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-analysis.schema.json",
  "title": "Source analysis report data",
  "description": "Evidence-backed findings prepared by the Skill agent and consumed by the local HTML report generator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "conclusions",
    "areas",
    "relationships",
    "entryClues",
    "flows",
    "extensionPoints",
    "risks",
    "unknowns",
    "analysisLimits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "summaryEvidence", "analysisScope"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "summary": { "$ref": "#/$defs/nonEmptyText" },
        "summaryEvidence": { "$ref": "#/$defs/evidenceList" },
        "analysisScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded", "method"],
          "properties": {
            "included": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" }, "minItems": 1, "maxItems": 20 },
            "excluded": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" }, "maxItems": 20 },
            "method": { "$ref": "#/$defs/nonEmptyText" }
          }
        }
      }
    },
    "conclusions": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "minItems": 1, "maxItems": 6 },
    "areas": {
      "type": "array",
      "items": { "$ref": "#/$defs/area" },
      "minItems": 1,
      "maxItems": 12,
      "description": "Major project areas and their responsibilities. Keep at module or directory granularity."
    },
    "relationships": {
      "type": "array",
      "maxItems": 14,
      "items": { "$ref": "#/$defs/relationship" },
      "description": "Every diagrammed relationship must include at least one direct source citation. Interpretive-only relationships belong in prose, not diagrams."
    },
    "entryClues": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "maxItems": 8 },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" }, "maxItems": 5 },
    "extensionPoints": { "type": "array", "items": { "$ref": "#/$defs/claim" }, "maxItems": 8 },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "severity", "evidence"],
        "properties": {
          "title": { "$ref": "#/$defs/nonEmptyText" },
          "description": { "$ref": "#/$defs/nonEmptyText" },
          "severity": { "enum": ["low", "medium", "high", "unknown"] },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "reason"],
        "properties": {
          "question": { "$ref": "#/$defs/nonEmptyText" },
          "reason": { "$ref": "#/$defs/nonEmptyText" },
          "checked": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } }
        }
      }
    },
    "analysisLimits": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" }, "minItems": 1, "maxItems": 8 }
  },
  "$defs": {
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "location", "basis", "note"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative source or documentation path; absolute paths and parent traversal are rejected."
        },
        "location": {
          "$ref": "#/$defs/nonEmptyText",
          "description": "Internal evidence pinpoint retained in analysis JSON; the renderer does not publish this location in report pages."
        },
        "basis": { "enum": ["direct", "interpretation"] },
        "note": { "$ref": "#/$defs/nonEmptyText" }
      }
    },
    "evidenceList": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "minItems": 1, "maxItems": 3 },
    "directEvidenceList": {
      "allOf": [
        { "$ref": "#/$defs/evidenceList" },
        {
          "contains": { "type": "object", "properties": { "basis": { "const": "direct" } }, "required": ["basis"] },
          "minContains": 1
        }
      ],
      "description": "At least one citation must directly support a displayed graph relationship."
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "evidence"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/nonEmptyText" },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "responsibility", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyText" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "responsibility": { "$ref": "#/$defs/nonEmptyText" },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label", "evidence"],
      "properties": {
        "from": { "$ref": "#/$defs/nonEmptyText" },
        "to": { "$ref": "#/$defs/nonEmptyText" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "evidence": { "$ref": "#/$defs/directEvidenceList" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "purpose", "purposeEvidence", "steps", "edges", "unknowns"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyText" },
        "purpose": { "$ref": "#/$defs/nonEmptyText" },
        "purposeEvidence": { "$ref": "#/$defs/evidenceList" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "description", "evidence"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyText" },
              "area": { "$ref": "#/$defs/nonEmptyText", "description": "Optional human-readable area or module context for the action shown in the diagram." },
              "label": {
                "$ref": "#/$defs/nonEmptyText",
                "description": "Concise reader-facing action label; do not use a raw source function name."
              },
              "description": { "$ref": "#/$defs/nonEmptyText" },
              "evidence": {
                "$ref": "#/$defs/evidenceList",
                "description": "If this step is an endpoint of a flow edge, at least one evidence item must have basis direct; the validator enforces this graph invariant."
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "label", "evidence"],
            "properties": {
              "from": { "$ref": "#/$defs/nonEmptyText" },
              "to": { "$ref": "#/$defs/nonEmptyText" },
              "label": { "$ref": "#/$defs/nonEmptyText" },
              "evidence": { "$ref": "#/$defs/directEvidenceList" }
            }
          }
        },
        "unknowns": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyText" } }
      }
    }
  }
}
